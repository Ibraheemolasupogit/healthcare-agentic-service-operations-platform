# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test / coverage / type-check caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Generated artefacts (kept out of version control; folders kept via .gitkeep) ---
# reports/ is transient/reproducible by default (regenerate via
# `python -m business_process.evidence` / `python -m power_platform.evidence` /
# `python -m ai.evaluation` / `python -m integrations.evidence` /
# `python -m analytics.fabric.evidence`); the
# explicitly unignored reports are intentionally tracked as portfolio evidence.
outputs/*
!outputs/.gitkeep
!outputs/README.md
reports/*
!reports/.gitkeep
!reports/README.md
!reports/case_summary.json
!reports/automation_summary.json
!reports/agentic_ai_evaluation_summary.json
!reports/analytics_summary.json
!reports/service_operations_report.md
!reports/integration_operations_summary.json
!reports/reconciliation_report.md

# --- Docker ---
*.log
